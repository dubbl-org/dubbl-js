{
  "name": "dubbl",
  "version": "0.1.0",
  "description": "The official Node.js client library for the Dubbl API — accounting, invoicing, payroll, inventory, and more.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "dubbl",
    "accounting",
    "invoicing",
    "bookkeeping",
    "payroll",
    "inventory",
    "api",
    "sdk",
    "typescript",
    "finance"
  ],
  "author": "Dubbl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dubbl-org/dubbl-js.git"
  },
  "homepage": "https://github.com/dubbl-org/dubbl-js#readme",
  "bugs": {
    "url": "https://github.com/dubbl-org/dubbl-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
